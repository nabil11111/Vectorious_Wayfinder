# Copy to .env. docker compose up works without it; these are the defaults it uses.
POSTGRES_USER=wayfinder
POSTGRES_PASSWORD=wayfinder
POSTGRES_DB=wayfinder

# Password for the seeded demo accounts (nadeesha, ishara, tharindu, ruwan, kasun, dilshan, prasanna). Admin has its own.
# Change both before putting the app on a public address.
SEED_PASSWORD=wayfinder-demo
SEED_ADMIN_PASSWORD=wayfinder-admin

# Proxies in front of the app: 0 when it is reached directly, 1 on Railway.
TRUST_PROXY=0

# true runs the app on its own clock with the seeded delivery day. false uses the real clock and seeds no day.
DEMO_MODE=true

# The live stream to open screens: a heartbeat every so many milliseconds, and how many streams may be open.
LIVE_HEARTBEAT_MS=20000
LIVE_MAX_STREAMS=200

# For running the API outside Docker (npm run dev). The database from compose listens on 5433.
DATABASE_URL=postgres://wayfinder:wayfinder@localhost:5433/wayfinder
PORT=3000
